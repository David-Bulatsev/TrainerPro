# Public entry point
PROXY_PORT=80
PUBLIC_SITE_URL=http://localhost
VITE_API_BASE_URL=/api

# PostgreSQL
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coach_app
POSTGRES_PORT=5432

# MinIO / object storage
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=coach-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_PRESIGN_EXPIRES_SECONDS=3600
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# External weather provider
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org
WEATHER_TIMEOUT_SECONDS=8
WEATHER_MAX_RETRIES=2
WEATHER_RATE_LIMIT=20
WEATHER_RATE_WINDOW_SECONDS=60
WEATHER_FORECAST_LIMIT=5
